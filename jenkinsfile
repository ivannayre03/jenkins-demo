pipeline {
    agent any
    stages {
        stage('Checkout') {
            steps { checkout scm }
        }
        stage('Build') {
            steps { bat '"C:\\Users\\ivann\\AppData\\Local\\Programs\\Python\\Python311\\python.exe" app.py' }
        }
        stage('Test') {
            steps { bat '"C:\\Users\\ivann\\AppData\\Local\\Programs\\Python\\Python311\\python.exe" test_app.py' }
        }
        stage('Deploy') {
            steps { echo 'Deploying the app...' }
        }
    }
    post {
        success { echo 'Pipeline SUCCESS' }
        failure { echo 'Pipeline FAILED' }
    }
}